{
  "name": "dickson-color-studio",
  "version": "1.0.1",
  "description": "Little Deng Student",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "build:native": "node-gyp rebuild --directory=protect",
    "protect": "node scripts/protect.js",
    "package": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && electron-builder --win --x64 --publish never",
    "sign:update": "node scripts/sign-update.js --yml dist/latest.yml",
    "verify:update": "node scripts/verify-update-sig.js --yml dist/latest.yml --sig dist/latest.yml.sig",
    "push:cos": "pwsh -NoProfile -File scripts/push-cos.ps1 -Dist dist -Bucket dickson-app-1313952720 -Region ap-guangzhou -Prefix app-update",
    "lic:init": "node scripts/licgen.js init",
    "lic:mid": "node scripts/licgen.js mid",
    "lic:issue": "node scripts/licgen.js issue",
    "lic:verify": "node scripts/licgen.js verify",
    "release": "npm run protect && npm run package && npm run sign:update && npm run verify:update"
  },
  "author": "Little Deng Student",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.1.1",
    "node-addon-api": "^7.1.1",
    "node-gyp": "^10.2.0"
  },
  "build": {
    "appId": "com.example.dickson",
    "productName": "dickson-color-studio",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    },
    "files": [
      "build-protect/**/*",
      "protect/**/*",
      "bootstrap.js",
      "src/**/*",
      "update-ui/**/*",
      "dialog-ui/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.gz",
      "!README.md",
      "!THIRD-PARTY-LICENSES.md",
      "!scripts/**",
      "!protect/protect.cc",
      "!protect/binding.gyp",
      "!protect/build/**"
    ],
    "win": {
      "icon": "src/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dickson-color-studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "XDTX-01",
        "repo": "dickson-app"
      }
    ]
  },
  "keywords": [],
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
