{
  "name": "dickson-color-studio",
  "version": "1.0.9",
  "description": "Little Deng Student",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "package": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && electron-builder --win --x64 --publish never",
    "build:native": "node-gyp rebuild --directory=protect",
    "protect": "node scripts/protect.js"
  },
  "author": "Little Deng Student",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.1.1",
    "node-addon-api": "^7.1.1",
    "node-gyp": "^10.2.0"
  },
  "build": {
    "appId": "com.example.dickson",
    "productName": "dickson-color-studio",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "build-protect/**/*"
    ],
    "compression": "maximum",
    "files": [
      "build-protect/**/*",
      "protect/**/*",
      "bootstrap.js",
      "main.js",
      "src/**/*",
      "update-ui/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.gz",
      "!README.md",
      "!THIRD-PARTY-LICENSES.md",
      "!release.js",
      "!scripts/**",
      "!protect/protect.cc",
      "!protect/binding.gyp",
      "!protect/build/**"
    ],
    "win": {
      "icon": "src/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dickson-color-studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "XDTX-01",
        "repo": "dickson-app"
      }
    ]
  },
  "keywords": [],
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
